# ===== Proveedor del modelo de lenguaje =====
# Elige un proveedor: anthropic | openai
LLM_PROVIDER=anthropic
# Modelo a usar (Haiku 4.5 = el mas economico y rapido)
LLM_MODEL=claude-haiku-4-5-20251001
# Tu clave va en el archivo .env real (NUNCA en .env.example ni en el repo)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ===== Topes de seguridad (control de costo) =====
MAX_ITERACIONES=25
MAX_TOKENS_SESION=120000

# ===== Servidor =====
PORT=3000
